load('ext://helm_resource', 'helm_resource')
load('ext://k8s_attach', 'k8s_attach')

# Order matters: the Nth profile is pinned to worker-N, whose name comes from
# the JoinConfiguration patches in local/kind/default.kind.yaml.
FLEET_PROFILES = ['a100', 't4']

_IMAGE = 'ghcr.io/nvidia/nvml-mock'
_CONTROL_PLANE_IMAGE = 'ghcr.io/nvidia/mokka-control-plane'
_CHART = 'deployments/nvml-mock/helm/nvml-mock'
_CRDS_CHART = 'deployments/mokka-crds/helm/mokka-crds'
_CRDS_RESOURCE = 'mokka-crds'
# The e2e suite queries this namespace (nvmlMockNamespace in
# tests/e2e/go/e2e_suite.go); keep the two in step.
_NAMESPACE = 'mokka'

# A tag given alongside a digest is informational only: the chart renders
# repository@digest whenever image.digest is set.
def _split_image(ref):
    name, digest = ref, ''
    at = ref.find('@')
    if at >= 0:
        name, digest = ref[:at], ref[at+1:]
        if not digest.startswith('sha256:') or len(digest) != len('sha256:') + 64:
            fail('--nvmlmock-image=%s: the digest must be sha256:<64 hex chars>' % ref)
    colon = name.rfind(':')
    # No colon at all, or the last colon is inside the registry (before the
    # last '/'), means there's no tag — e.g. 'ghcr.io/foo' or 'reg:5000/foo'.
    if colon < 0 or colon < name.rfind('/'):
        if not digest:
            fail('--nvmlmock-image=%s must be repo:tag or repo@sha256:<digest>' % ref)
        return name, '', digest
    return name[:colon], name[colon+1:], digest

def build_nvml_mock_image(nvmlmock_image=''):
    if nvmlmock_image:
        return
    # only= names whole top-level trees, so new subdirs need no change. A new
    # top-level tree COPYed by the Dockerfile does, or its COPY fails on a path the
    # context omits.
    docker_build(
        _IMAGE,
        context='.',
        dockerfile='deployments/nvml-mock/Dockerfile',
        only=[
            'go.mod',
            'go.sum',
            'api/',
            'cmd/',
            'pkg/',
            'internal/',
            'shims/',
            'Makefile',
            'deployments/nvml-mock/',
        ],
    )

def build_control_plane_image():
    docker_build(
      _CONTROL_PLANE_IMAGE,
        context='.',
        dockerfile='deployments/control-plane/Dockerfile',
        only=[
            'go.mod',
            'go.sum',
            'api/',
            'cmd/',
            'pkg/',
            'internal/',
            'deployments/control-plane/',
        ],
    )

def install_control_plane_crds():
    helm_resource(
        _CRDS_RESOURCE,
        _CRDS_CHART,
        namespace=_NAMESPACE,
        flags=['--create-namespace'],
        labels=['mokka-core'],
    )

def _install(release, profile, active_consumers, extra_set, nvmlmock_image='', control_plane=False):
    flags = []

    # Helm applies --set after every --values file, so an unconditional one would
    # shadow the chart default and any overlay that pins a profile.
    if profile:
        flags += ['--set', 'gpu.profile=' + profile]

    for kv in extra_set:
        flags += ['--set', kv]

    if nvmlmock_image:
        repo, tag, digest = _split_image(nvmlmock_image)
        flags += ['--set', 'image.repository=' + repo]
        if tag:
            flags += ['--set', 'image.tag=' + tag]
        if digest:
            flags += ['--set', 'image.digest=' + digest]

    # build_control_plane_image() must have run so the image_deps reference
    # below resolves.
    if control_plane:
        flags += ['--set', 'controlPlane.enabled=true']

    if os.path.exists('local/nvml-mock.values.yaml'):
        flags += ['--values', 'local/nvml-mock.values.yaml']

    for consumer in active_consumers:
        overlay = 'local/' + consumer + '/nvml-mock.values.yaml'
        if os.path.exists(overlay):
            flags += ['--values', overlay]

    # CI writes its scenario tuning here before `tilt ci` (see
    # tests/e2e/ci/nvml-mock.values.yaml).
    if os.path.exists('local/nvml-mock.values.local.yaml'):
        flags += ['--values', 'local/nvml-mock.values.local.yaml']

    flags = flags + ['--create-namespace']

    # image_deps must name an image Tilt builds, so the mock image is listed only
    # when docker_build ran.
    image_deps = []
    image_keys = []
    if not nvmlmock_image:
        image_deps.append(_IMAGE)
        image_keys.append(('image.repository', 'image.tag'))
    if control_plane:
        image_deps.append(_CONTROL_PLANE_IMAGE)
        image_keys.append(('controlPlane.image.repository', 'controlPlane.image.tag'))

    if image_deps:
        helm_resource(
            release,
            _CHART,
            namespace=_NAMESPACE,
            image_deps=image_deps,
            image_keys=image_keys,
            flags=flags,
            labels=['mokka-core'],
        )
    else:
        helm_resource(
            release,
            _CHART,
            namespace=_NAMESPACE,
            flags=flags,
            labels=['mokka-core'],
        )

    if control_plane:
        k8s_attach(
            name='control-plane',
            obj='deployment/' + release + '-control-plane',
            namespace=_NAMESPACE,
            resource_deps=[release],
            labels=['mokka-core'],
        )

def install_single(profile, active_consumers, nvmlmock_image='', control_plane=False):
    _install(
        'nvml-mock', profile, active_consumers,
        extra_set=[],
        nvmlmock_image=nvmlmock_image,
        control_plane=control_plane,
    )

    return ['nvml-mock']

def install_fleet(active_consumers, profiles = FLEET_PROFILES, nvmlmock_image='', control_plane=False):
    """The chart's fullname collapses to the release name when it contains the chart
    name, so 'nvml-mock-a100' and 'nvml-mock-t4' own distinct DaemonSets,
    ConfigMaps and RBAC.
    """
    for i in range(len(profiles)):
        _install(
            'nvml-mock-' + profiles[i],
            profiles[i],
            active_consumers,
            # helm --set reads '.' as a path separator, so the dot in
            # kubernetes.io is escaped to keep the label key in one piece.
            extra_set=['nodeSelector.kubernetes\\.io/hostname=worker-%d' % i],
            nvmlmock_image=nvmlmock_image,
            control_plane=control_plane and i == 0,
        )

    return ['nvml-mock-' + p for p in profiles]
