#
# Loadable Tiltfile: NVIDIA DRA driver consumer.
#
# Exports:
#   install(nvml_mock_releases, extra_values=[])
#     — install the DRA driver on top of nvml-mock. Optional extra_values
#     is a list of paths to additional --values files layered on top of
#     dra-driver.values.yaml (later paths win on key conflicts).
#
# Requires the shared 'nvidia' helm_repo, registered by the main Tiltfile and
# waited on through resource_deps. Also requires the cluster to have
# DynamicResourceAllocation + resource.k8s.io/v1beta1 enabled (both are set by
# local/kind/default.kind.yaml).
#
# In --multi-gpu-profile mode the driver publishes a distinct ResourceSlice per
# worker, so the fleet's two profiles surface as heterogeneous devices in a
# single cluster. Composes with the GPU Operator consumer — the two live on
# different Kubernetes surfaces (ResourceClaim vs. nvidia.com/gpu) and both
# talk to the same mock NVML library.

load('ext://helm_resource', 'helm_resource')

_REPO_RESOURCE = 'nvidia'

# Pinned rather than floating: an upstream chart release would otherwise land in
# CI without a commit, so a red e2e-dra run could not be told apart from a
# regression in this repo. Bump deliberately.
_CHART = 'nvidia/dra-driver-nvidia-gpu'
_CHART_VERSION = '0.5.0'

def install(nvml_mock_releases, extra_values=[]):
    values_flags = ['--values', 'local/dra/dra-driver.values.yaml']
    for v in extra_values:
        values_flags += ['--values', v]

    helm_resource(
        'nvidia-dra-driver',
        _CHART,
        namespace='nvidia',
        flags=['--create-namespace', '--version', _CHART_VERSION] + values_flags + ['--timeout', '300s'],
        resource_deps=[_REPO_RESOURCE] + nvml_mock_releases,
        labels=['dra'],
    )
