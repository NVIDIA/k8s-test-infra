#
# Needs a cluster that serves DRA (the DynamicResourceAllocation gate and
# resource.k8s.io/v1beta1); both Kind configs set them.

load('ext://helm_resource', 'helm_resource')

_REPO_RESOURCE = 'nvidia'

_CHART = 'nvidia/dra-driver-nvidia-gpu'
_CHART_VERSION = '0.5.0'

def install(nvml_mock_releases, extra_values=[], image_deps=[], image_keys=[]):
    values_flags = ['--values', 'local/dra/dra-driver.values.yaml']
    for v in extra_values:
        values_flags += ['--values', v]

    helm_resource(
        'nvidia-dra-driver',
        _CHART,
        namespace='nvidia',
        image_deps=image_deps,
        image_keys=image_keys,
        flags=['--create-namespace', '--version', _CHART_VERSION] + values_flags + ['--timeout', '300s'],
        resource_deps=[_REPO_RESOURCE] + nvml_mock_releases,
        labels=['dra'],
    )
