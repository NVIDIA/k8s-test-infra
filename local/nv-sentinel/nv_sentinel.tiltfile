#
# Loadable Tiltfile: NVIDIA NVSentinel consumer.
#
# Exports:
#   GPU_OPERATOR_VALUES — path to the values overlay the root layers on top of
#                         local/gpu-operator/gpu-operator.values.yaml to enable
#                         the standalone DCGM DaemonSet NVSentinel polls.
#   install(nvml_mock_releases) — install cert-manager, the external MongoDB,
#                         NVSentinel and a GPU workload, and register the
#                         quarantine/recover triggers.
#
# What this consumer demonstrates: NVSentinel — NVIDIA's open-source GPU health
# monitoring and fault-remediation service — detects a GPU thermal-margin
# violation on mock GPUs, cordons and drains the node so the GPU workload
# reschedules, and uncordons it once the GPU cools. On a cluster with no GPUs.
#
# Assumes --gpu-operator: the standalone DCGM DaemonSet NVSentinel polls is one
# of the Operator's operands, so without it there is nothing to poll. The root
# Tiltfile implies the flag rather than failing on it.
#
# Ported from docs/demo/nv-sentinel/run.sh, which still exists as a standalone
# demo for use without Tilt. Two things in that script disappear here: the
# per-worker nvidia-container-toolkit install and CDI wiring (the shared Kind
# node image bakes both in) and its dedicated cluster (the default profile is
# already 1 control-plane + 2 workers).
#
# All side effects inside functions so load()ing this file is a pure import.

load('ext://helm_resource', 'helm_resource')

GPU_OPERATOR_VALUES = 'local/nv-sentinel/gpu-operator.values.yaml'

_NAMESPACE = 'nvsentinel'
_CERT_MANAGER_RELEASE = 'cert-manager'
_CERT_MANAGER_NAMESPACE = 'cert-manager'
# Pinned to the version docs/demo/nv-sentinel/run.sh installs.
_CERT_MANAGER_VERSION = 'v1.19.1'
_CERT_MANAGER_REPO_RESOURCE = 'jetstack'
_MONGODB_CERTS_RESOURCE = 'mongodb-certs'
_MONGODB_CERTS_READY_RESOURCE = 'mongodb-certs-ready'
# Self-signed issuance is a sub-second operation once cert-manager's webhook is
# live, which the release above already waited for. The budget is for a Kind
# cluster busy pulling GPU Operator operands, not for the crypto.
_CERT_READY_TIMEOUT_S = 180
_NVSENTINEL_RELEASE = 'nvsentinel'
_NVSENTINEL_CHART = 'oci://ghcr.io/nvidia/nvsentinel'
# Pinned to the version docs/demo/nv-sentinel/run.sh installs. The values file
# sets subchart keys (gpu-health-monitor, node-drainer, fault-quarantine) that a
# floating version could rename, which Helm accepts silently.
_NVSENTINEL_VERSION = 'v1.15.0'
_READY_RESOURCE = 'nvsentinel-ready'
# Generous: cert-manager's --wait covers three Deployments and its webhook
# becoming live, on a Kind cluster that is simultaneously pulling GPU Operator
# operands.
_HELM_TIMEOUT_S = 600


def install(nvml_mock_releases):
    """Install the NVSentinel stack and register its scenarios."""
    # Tilt caps a k8s apply at 30s by default, which cert-manager's --wait blows
    # through — the build then fails with a bare "apply command timed out" that
    # never mentions helm. Raised only when this consumer is active.
    update_settings(k8s_upsert_timeout_secs=_HELM_TIMEOUT_S + 60)

    _install_cert_manager(nvml_mock_releases)
    _install_mongodb()
    _install_nvsentinel()
    _install_workload()
    _register_scenarios()


def _install_cert_manager(nvml_mock_releases):
    """Install cert-manager, the TLS dependency of MongoDB and NVSentinel."""
    helm_resource(
        _CERT_MANAGER_RELEASE,
        'jetstack/cert-manager',
        namespace=_CERT_MANAGER_NAMESPACE,
        flags=[
            '--create-namespace',
            '--version', _CERT_MANAGER_VERSION,
            # The chart skips its CRDs unless asked, and the MongoDB manifest
            # applied next includes four cert-manager custom resources.
            '--set', 'crds.enabled=true',
            # --wait, unlike most consumers here: the Issuer/Certificate objects
            # in mongodb.k8s.yaml are rejected until the webhook is live, and
            # helm_resource cannot map this release's pods to the Tilt resource
            # (no Tilt-built image to match on), so without it the resource goes
            # green the moment `helm upgrade` returns.
            '--wait', '--timeout', '%ds' % _HELM_TIMEOUT_S,
        ],
        # The helm repo resource must have run before the chart can be
        # resolved; nvml-mock is UI ordering, matching the other consumers.
        resource_deps=[_CERT_MANAGER_REPO_RESOURCE] + nvml_mock_releases,
        labels=['nv-sentinel'],
    )


def _install_mongodb():
    """Deploy the external MongoDB replica set NVSentinel stores events in."""
    k8s_yaml('local/nv-sentinel/mongodb.k8s.yaml')

    k8s_resource(
        new_name=_MONGODB_CERTS_RESOURCE,
        objects=[
            '%s:namespace' % _NAMESPACE,
            'mongodb-selfsigned:issuer:%s' % _NAMESPACE,
            'mongodb-ca:certificate:%s' % _NAMESPACE,
            'mongodb-ca-issuer:issuer:%s' % _NAMESPACE,
            'mongodb-server:certificate:%s' % _NAMESPACE,
        ],
        # Hard dependency, not UI ordering: the Certificates are cert-manager
        # CRs and its webhook must be live to admit them.
        resource_deps=[_CERT_MANAGER_RELEASE],
        labels=['nv-sentinel'],
    )

    # Applying a Certificate only asks cert-manager to issue one; the Secret it
    # writes appears seconds later. The StatefulSet mounts that Secret, so
    # shipping both in one resource starts the pod against a Secret that does
    # not exist yet: kubelet reports `FailedMount ... secret
    # "mongodb-server-tls" not found` and then retries on an exponential
    # backoff that outlasts the issuance by minutes. Waiting on the
    # Certificates instead makes the Secret a precondition of the pod.
    #
    # Both Certificates, not just the server one: mongodb-ca-issuer signs with
    # the CA Secret, and NVSentinel mounts it as its trust root
    # (global.datastore.tls.caSecretName), so a missing CA fails the same way
    # one layer down.
    local_resource(
        _MONGODB_CERTS_READY_RESOURCE,
        cmd=' '.join([
            'kubectl wait --for=condition=Ready',
            '--timeout=%ds' % _CERT_READY_TIMEOUT_S,
            '-n', _NAMESPACE,
            'certificate/mongodb-ca certificate/mongodb-server',
        ]),
        resource_deps=[_MONGODB_CERTS_RESOURCE],
        labels=['nv-sentinel'],
    )

    k8s_resource(
        'mongodb-ext',
        objects=['nvsentinel-datastore-mongodb-uri:secret:%s' % _NAMESPACE],
        resource_deps=[_MONGODB_CERTS_READY_RESOURCE],
        labels=['nv-sentinel'],
    )


def _install_nvsentinel():
    """Install NVSentinel against the external MongoDB and the DCGM Service."""
    helm_resource(
        _NVSENTINEL_RELEASE,
        _NVSENTINEL_CHART,
        namespace=_NAMESPACE,
        flags=[
            '--version', _NVSENTINEL_VERSION,
            '--values', 'local/nv-sentinel/nvsentinel.values.yaml',
            '--timeout', '%ds' % _HELM_TIMEOUT_S,
            # Deliberately NO --wait. The collection-setup Job is a post-install
            # hook, and the DB-consuming pods cannot become Ready until it has
            # run — but Helm runs post-install hooks only after --wait is
            # satisfied, so --wait deadlocks the release against its own hook.
            # nvsentinel-ready below is what actually waits.
        ],
        # mongodb-ext is a hard dependency: the release reads the datastore
        # Secret and needs a PRIMARY to open change streams against, which this
        # pod being Ready now means — its postStart hook initiates rs0 and its
        # readiness probe asserts a writable primary.
        # gpu-operator only orders the two — a green Operator release does not
        # mean the standalone DCGM is serving yet, since its ~2 GB image is
        # still pulling, so the wait the health monitor actually needs is on the
        # Service's endpoints, in nvsentinel-ready.
        resource_deps=['mongodb-ext', 'gpu-operator'],
        labels=['nv-sentinel'],
    )

    local_resource(
        _READY_RESOURCE,
        cmd='bash local/nv-sentinel/nvsentinel-ready.sh',
        resource_deps=[_NVSENTINEL_RELEASE],
        labels=['nv-sentinel'],
    )


def _install_workload():
    """Deploy the GPU workload the drainer evicts when it quarantines a node."""
    k8s_yaml('local/nv-sentinel/gpu-workload.k8s.yaml')

    k8s_resource(
        'gpu-sample-workload',
        # Not just UI ordering: a pod scheduled before node-drainer is running
        # would sit on the node through the quarantine and never be evicted.
        resource_deps=[_READY_RESOURCE],
        labels=['nv-sentinel'],
    )


def _register_scenarios():
    """Register the quarantine and recovery scenarios as manual triggers.

    Manual (auto_init=False), mirroring the observability and compute-domain
    scenarios: they inject into a live stack and assert what NVSentinel does
    about it, so they are something you do while watching, not part of bring-up.
    Both exit non-zero on failure, which turns the Tilt resource red.

    recover-node refuses to run unless a node is actually quarantined, so the
    order is quarantine-node then recover-node; it is not a cleanup step for a
    healthy cluster.
    """
    for scenario in ['quarantine-node', 'recover-node']:
        local_resource(
            scenario,
            cmd='bash local/nv-sentinel/scenarios/%s.sh' % scenario,
            # quarantine-node needs the workload as the drainer's eviction
            # target. recover-node only reports where it ended up, but shares
            # the dependency because it recovers what quarantine-node did, so
            # offering it before that can run would only invite a failed run.
            resource_deps=['gpu-sample-workload'],
            auto_init=False,
            labels=['nv-sentinel-tests'],
        )
