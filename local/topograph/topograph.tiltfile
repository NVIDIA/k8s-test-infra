#
# Loadable Tiltfile: NVIDIA topograph consumer.
#
# Exports:
#   install(nvml_mock_releases) — install topograph on top of the
#     nvml-mock stack. Returns nothing.
#
# Coupling (implicit in the root Tiltfile):
#   --topograph implies --compute-domain and --dra. The compute-domain
#   scenario is the only place cliques exist (see topology.yaml + the
#   nvml-mock/clique kind labels), and the NVIDIA DRA driver's
#   compute-domain-kubelet-plugin is the component that reads mock NVML
#   and writes the nvidia.com/gpu.clique node label topograph consumes.
#   The label writer is gated by kubeletPlugin.containers.computeDomains.
#   gpuCliqueLabelEnabled (default false); local/topograph/dra-driver.
#   values.yaml flips it on and is layered into the DRA install by the
#   root Tiltfile's DRA overlay chain.
#
# Data path:
#   nvml-mock topology.yaml → mock NVML clique_id → DRA kubelet-plugin
#   patches nvidia.com/gpu.clique on nodes → topograph 'dra' provider
#   reads that label → topograph writes network.topology.nvidia.com/*
#   labels.

load('ext://helm_resource', 'helm_resource')

def install(nvml_mock_releases):
    helm_resource(
        'topograph',
        'oci://ghcr.io/nvidia/topograph/topograph',
        namespace='topograph',
        flags=[
            '--create-namespace',
            '--values', 'local/topograph/topograph.values.yaml',
            '--timeout', '300s',
        ],
        # Wait for nvml-mock (mock NVML must be serving fabric info) and
        # the DRA driver (its kubelet-plugin writes the clique label
        # topograph reads). The plugin patches on startup, so ordering
        # by the DRA release's readiness is sufficient.
        resource_deps=nvml_mock_releases + ['nvidia-dra-driver'],
        labels=['topograph'],
    )
