load('ext://helm_resource', 'helm_resource')

_REPO_RESOURCE = 'topograph-repo'
_NVIDIA_SMI = 'topograph-nvidia-smi'

# Pinned rather than floating, like the other consumers: an upstream release
# would otherwise change the values schema under this repo without a commit.
_CHART_VERSION = '1.1.0'

def install(nvml_mock_releases):
    k8s_yaml('local/topograph/nvidia-smi.k8s.yaml')
    k8s_resource(
        workload='nvidia-smi',
        new_name=_NVIDIA_SMI,
        objects=['topograph:namespace'],
        # The NRI plugin injects the mock driver only into containers created
        # after it registers.
        resource_deps=nvml_mock_releases,
        labels=['topograph'],
    )

    helm_resource(
        'topograph',
        'topograph-repo/topograph',
        namespace='topograph',
        flags=[
            '--create-namespace',
            '--version', _CHART_VERSION,
            '--values', 'local/topograph/topograph.values.yaml',
            '--timeout', '300s',
        ],
        # The broker queries nvidia-smi once, when it starts, so its target
        # pods must be up first; a node without one gets no domain label.
        resource_deps=[_REPO_RESOURCE, _NVIDIA_SMI],
        labels=['topograph'],
    )
