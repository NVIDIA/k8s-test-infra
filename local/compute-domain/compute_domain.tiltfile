#
# Loadable Tiltfile for the compute-domain scenario.
#
# Scenario, not consumer: compute-domain reconfigures the nvml-mock stack
# itself (gb200 profile, topology ConfigMap, 4-worker cluster) rather than
# sitting on top of it. So it exports build/install
# the way local/nvml_mock.tiltfile does — the root Tiltfile calls
# compute_domain.install() as the BASE install path when --compute-domain
# is set, replacing the install_single()/install_fleet() calls.
#
# Ports the per-node fabric identity and topology rebind scenarios of
# docs/guides/compute-domain/run.sh as auto_init=False local_resource
# triggers.
#
# The scenario runs the standard nvml-mock image. On the gb200 profile the
# node agent stages IMEX itself (see the chart's imex values), and the DRA
# driver runs its unmodified upstream images (see dra-driver.values.yaml).
#
# Exports:
#   build_image(nvmlmock_image) — build the nvml-mock image, unless a
#     pre-built ref is given.
#   install(active_consumers, nvmlmock_image, control_plane) — install one
#     nvml-mock helm release with the topology overlay + scenario
#     triggers. Returns ['nvml-mock', 'imex-staged'].
#
# All side effects inside functions so load()ing this file is a pure import.

load('ext://helm_resource', 'helm_resource')
load('ext://k8s_attach', 'k8s_attach')
load('../nvml_mock.tiltfile', 'split_image')

_IMAGE      = 'nvml-mock:compute-domain'
_NAMESPACE  = 'mokka'
_CHART      = 'deployments/nvml-mock/helm/nvml-mock'
_DOCKERFILE = 'deployments/nvml-mock/Dockerfile'


def build_image(nvmlmock_image=''):
    """Build the nvml-mock image, unless nvmlmock_image names a pre-built one.

    Same Dockerfile as local/nvml_mock.tiltfile, so this list has to carry
    the same trees.
    """
    if nvmlmock_image:
        return
    docker_build(
        _IMAGE,
        context='.',
        dockerfile=_DOCKERFILE,
        only=[
            'go.mod',
            'go.sum',
            'api/',
            'cmd/',
            'pkg/',
            'internal/',
            'shims/',
            'Makefile',
            'deployments/nvml-mock/',
        ],
    )


def install(active_consumers, nvmlmock_image='', control_plane=False):
    """Install the nvml-mock helm release with the compute-domain topology.

    Returns ['nvml-mock', 'imex-staged'] so downstream consumers (dra,
    gpu-operator) can pass it as resource_deps and start once IMEX is staged.

    nvmlmock_image pins a pre-built image (CI) instead of the one
    build_image() builds.

    control_plane=True flips controlPlane.enabled on the release and
    threads the CP image through image_deps so Tilt rebuilds → pins →
    rolls the Deployment alongside the compute-domain scenario.
    """
    # The mokka namespace, as local/nvml_mock.tiltfile installs: the NRI
    # plugin never injects the release's own namespace, so a release in
    # default would leave the workloads there without mock GPUs.
    flags = [
        '--create-namespace',
        '--values', 'local/compute-domain/topology.yaml',
        '--values', 'local/compute-domain/nvml-mock.values.yaml',
    ]

    # Optional per-consumer overlays. Consumers with no mock-side needs
    for consumer in active_consumers:
        overlay = 'local/' + consumer + '/nvml-mock.values.yaml'
        if os.path.exists(overlay):
            flags += ['--values', overlay]

    # The CI hook for values the job computes, as in local/nvml_mock.tiltfile.
    if os.path.exists('local/nvml-mock.values.local.yaml'):
        flags += ['--values', 'local/nvml-mock.values.local.yaml']

    image_deps = []
    image_keys = []
    if nvmlmock_image:
        repo, tag, digest = split_image(nvmlmock_image)
        flags += ['--set', 'image.repository=' + repo]
        if tag:
            flags += ['--set', 'image.tag=' + tag]
        if digest:
            flags += ['--set', 'image.digest=' + digest]
    else:
        image_deps.append(_IMAGE)
        image_keys.append(('image.repository', 'image.tag'))
    if control_plane:
        flags += ['--set', 'controlPlane.enabled=true']
        image_deps.append('ghcr.io/nvidia/mokka-control-plane')
        image_keys.append(('controlPlane.image.repository', 'controlPlane.image.tag'))

    # Tilt looks image_deps up in the resource graph, so they go only when
    # build_image() actually built something.
    if image_deps:
        helm_resource(
            'nvml-mock',
            _CHART,
            namespace=_NAMESPACE,
            image_deps=image_deps,
            image_keys=image_keys,
            flags=flags,
            labels=['mokka'],
        )
    else:
        helm_resource('nvml-mock', _CHART, namespace=_NAMESPACE, flags=flags, labels=['mokka'])

    if control_plane:
        k8s_attach(
            name='nvml-mock-control-plane',
            obj='deployment/nvml-mock-control-plane',
            namespace='mokka',
            resource_deps=['nvml-mock'],
            labels=['mokka-core'],
        )

    # Scenario 1: per-node fabric identity via check-fabric. Manually
    # triggered — hitting the button asserts the topology overlay
    # rendered the expected cliqueId / clusterUuid / state on each node.
    local_resource(
        'check-fabric',
        cmd='bash local/compute-domain/scenarios/check-fabric.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    # Topology rebind: helm upgrade --reuse-values -f rebind.topology.yaml,
    # evict DaemonSet pods so mock NVML re-reads MOCK_TOPOLOGY_CONFIG,
    # re-assert new clique/UUID on every worker.
    local_resource(
        'topology-rebind',
        cmd='bash local/compute-domain/scenarios/topology-rebind.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    # The DRA driver's compute-domain kubelet plugin looks for the IMEX
    # binaries only when it starts, so consumers wait until every node has
    # staged IMEX, which a download can take a while to do.
    local_resource(
        'imex-staged',
        cmd='bash local/compute-domain/scenarios/wait-imex.sh',
        resource_deps=['nvml-mock'],
        labels=['mokka'],
    )

    return ['nvml-mock', 'imex-staged']
