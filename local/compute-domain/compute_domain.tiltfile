#
# Ports Scenario 1 (per-node fabric identity) and Scenario 3 (topology rebind) of
# docs/guides/compute-domain/run.sh as manual triggers. Scenario 2, the real IMEX
# daemon coordination, stays in run.sh: it is a stateful multi-pod sequence that
# does not fit Tilt's model.

load('ext://helm_resource', 'helm_resource')
load('ext://k8s_attach', 'k8s_attach')

_BASE_IMAGE         = 'nvml-mock:compute-domain'
_DEMO_IMAGE         = 'nvml-mock:compute-domain-imex'
DAEMON_IMAGE        = 'nvml-mock:compute-domain-daemon'
_CHART              = 'deployments/nvml-mock/helm/nvml-mock'
_MOCK_DOCKERFILE    = 'deployments/nvml-mock/Dockerfile'
_OVERLAY_DOCKERFILE = 'deployments/nvml-mock/Dockerfile.compute-domain-daemon'


def build_images(with_dra):
    # Same Dockerfile as nvml_mock.tiltfile, so only= must list the same trees.
    docker_build(
        _BASE_IMAGE,
        context='.',
        dockerfile=_MOCK_DOCKERFILE,
        only=[
            'go.mod',
            'go.sum',
            'api/',
            'cmd/',
            'pkg/',
            'internal/',
            'shims/',
            'Makefile',
            'deployments/nvml-mock/',
        ],
    )

    # kubectl exec workflows (check-fabric, IMEX daemon start/kill) need the real
    # binaries at their canonical paths.
    docker_build(
        _DEMO_IMAGE,
        context='.',
        dockerfile=_OVERLAY_DOCKERFILE,
        target='demo',
        build_args={'NVML_MOCK_IMAGE': _BASE_IMAGE},
        only=[
            'go.mod',
            'go.sum',
            'shims/nvidia-imex-shim/',
        ],
    )

    if with_dra:
        # Replaces the upstream compute-domain-daemon image so the DRA driver's
        # daemon pods run the shimmed real IMEX in no-GPU mode instead of the
        # GPU-requiring upstream binary.
        docker_build(
            DAEMON_IMAGE,
            context='.',
            dockerfile=_OVERLAY_DOCKERFILE,
            target='daemon',
            only=[
                'go.mod',
                'go.sum',
                'shims/nvidia-imex-shim/',
            ],
        )


def install(active_consumers, control_plane=False):
    flags = [
        '--values', 'local/compute-domain/topology.yaml',
        '--values', 'local/compute-domain/nvml-mock.values.yaml',
    ]

    for consumer in active_consumers:
        overlay = 'local/' + consumer + '/nvml-mock.values.yaml'
        if os.path.exists(overlay):
            flags += ['--values', overlay]

    image_deps = [_DEMO_IMAGE]
    image_keys = [('image.repository', 'image.tag')]
    if control_plane:
        flags += ['--set', 'controlPlane.enabled=true']
        image_deps.append('ghcr.io/nvidia/mokka-control-plane')
        image_keys.append(('controlPlane.image.repository', 'controlPlane.image.tag'))

    helm_resource(
        'nvml-mock',
        _CHART,
        image_deps=image_deps,
        image_keys=image_keys,
        flags=flags,
        labels=['mokka'],
    )

    if control_plane:
        k8s_attach(
            name='nvml-mock-control-plane',
            obj='deployment/nvml-mock-control-plane',
            namespace='mokka',
            resource_deps=['nvml-mock'],
            labels=['mokka-core'],
        )

    local_resource(
        'check-fabric',
        cmd='bash local/compute-domain/scenarios/check-fabric.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    local_resource(
        'topology-rebind',
        cmd='bash local/compute-domain/scenarios/topology-rebind.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    return ['nvml-mock']
