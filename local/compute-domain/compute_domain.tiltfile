#
# Loadable Tiltfile for the compute-domain scenario.
#
# Scenario, not consumer: compute-domain reconfigures the nvml-mock stack
# itself (gb200 profile, topology ConfigMap, 4-worker
# cluster) rather than sitting on top of it. So it exports build/install
# the way local/nvml_mock.tiltfile does — the root Tiltfile calls
# compute_domain.install() as the BASE install path when --compute-domain
# is set, replacing the install_single()/install_fleet() calls.
#
# Ports docs/guides/compute-domain/run.sh Scenario 1 (per-node fabric
# identity) and Scenario 3 (topology rebind) as auto_init=False
# local_resource triggers. The real IMEX lifecycle is covered by the E2E
# suite because it is a stateful multi-pod state machine.
#
# Exports:
#   build_images(with_dra) — build the Mokka image and, with DRA, its adapter.
#   install(active_consumers) — install one nvml-mock helm release
#     with the topology overlay + scenario triggers. Returns ['nvml-mock'].
#
# All side effects inside functions so load()ing this file is a pure import.

load('ext://helm_resource', 'helm_resource')
load('ext://k8s_attach', 'k8s_attach')

_BASE_IMAGE         = 'nvml-mock:compute-domain'
# Exported (no leading underscore): the root Tiltfile uses it to drive the
# adapter build and pin the DRA chart image when composing
# --compute-domain --dra.
DRA_ADAPTER_IMAGE   = 'mokka-dra-adapter:compute-domain'
_CHART              = 'deployments/nvml-mock/helm/nvml-mock'
_MOCK_DOCKERFILE    = 'deployments/nvml-mock/Dockerfile'
_DRA_DOCKERFILE     = 'local/dra/Dockerfile'


def build_images(with_dra):
    """Build the unified Mokka image and optional DRA adapter.

    The standard Mokka image includes IMEX. When with_dra is True, also
    build the adapter that adds those files to the upstream
    compute-domain-daemon image.
    """
    # Locally tagged rather than using the ghcr.io ref from
    # local/nvml_mock.tiltfile so the optional DRA adapter can use this
    # exact image as its external source stage.
    # Same Dockerfile as local/nvml_mock.tiltfile, so this list has to carry
    # the same trees.
    docker_build(
        _BASE_IMAGE,
        context='.',
        dockerfile=_MOCK_DOCKERFILE,
        only=[
            'go.mod',
            'go.sum',
            'cmd/',
            'pkg/',
            'internal/',
            'shims/',
            'Makefile',
            'deployments/nvml-mock/',
        ],
    )

    if with_dra:
        # The upstream DRA runtime remains the final image. It receives the
        # IMEX executables already pinned and verified in the Mokka image.
        docker_build(
            DRA_ADAPTER_IMAGE,
            context='.',
            dockerfile=_DRA_DOCKERFILE,
            build_args={'NVML_MOCK_IMAGE': _BASE_IMAGE},
            only=[
                'local/dra/Dockerfile',
            ],
        )


def install(active_consumers, control_plane=False):
    """Install the nvml-mock helm release with the compute-domain topology.

    Returns ['nvml-mock'] so downstream consumers (dra, gpu-operator)
    can pass it as resource_deps.

    control_plane=True flips controlPlane.enabled on the release and
    threads the CP image through image_deps so Tilt rebuilds → pins →
    rolls the Deployment alongside the compute-domain scenario.
    """
    flags = [
        '--values', 'local/compute-domain/topology.yaml',
        '--values', 'local/compute-domain/nvml-mock.values.yaml',
    ]

    # Optional per-consumer overlays. Consumers with no mock-side needs
    for consumer in active_consumers:
        overlay = 'local/' + consumer + '/nvml-mock.values.yaml'
        if os.path.exists(overlay):
            flags += ['--values', overlay]

    image_deps = [_BASE_IMAGE]
    image_keys = [('image.repository', 'image.tag')]
    if control_plane:
        flags += ['--set', 'controlPlane.enabled=true']
        image_deps.append('ghcr.io/nvidia/mokka-control-plane')
        image_keys.append(('controlPlane.image.repository', 'controlPlane.image.tag'))

    helm_resource(
        'nvml-mock',
        _CHART,
        image_deps=image_deps,
        image_keys=image_keys,
        flags=flags,
        labels=['mokka'],
    )

    if control_plane:
        k8s_attach(
            name='nvml-mock-control-plane',
            obj='deployment/nvml-mock-control-plane',
            namespace='mokka',
            resource_deps=['nvml-mock'],
            labels=['mokka-core'],
        )

    # Scenario 1: per-node fabric identity via check-fabric. Manually
    # triggered — hitting the button asserts the topology overlay
    # rendered the expected cliqueId / clusterUuid / state on each node.
    local_resource(
        'check-fabric',
        cmd='bash local/compute-domain/scenarios/check-fabric.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    # Scenario 3: helm upgrade --reuse-values -f rebind.topology.yaml,
    # evict DaemonSet pods so mock NVML re-reads MOCK_TOPOLOGY_CONFIG,
    # re-assert new clique/UUID on every worker.
    local_resource(
        'topology-rebind',
        cmd='bash local/compute-domain/scenarios/topology-rebind.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    return ['nvml-mock']
