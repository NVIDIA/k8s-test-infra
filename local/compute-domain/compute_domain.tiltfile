#
# Ports Scenario 1 (per-node fabric identity) and Scenario 2 (topology rebind) of
# docs/guides/compute-domain/run.sh as manual triggers. The scenario runs the
# standard nvml-mock image: on gb200 the node agent stages IMEX, and the DRA
# driver keeps its upstream images.

load('ext://helm_resource', 'helm_resource')
load('ext://k8s_attach', 'k8s_attach')
load('../nvml_mock.tiltfile', 'split_image')

_IMAGE      = 'nvml-mock:compute-domain'
_NAMESPACE  = 'mokka'
_CHART      = 'deployments/nvml-mock/helm/nvml-mock'
_DOCKERFILE = 'deployments/nvml-mock/Dockerfile'


def build_image(nvmlmock_image=''):
    if nvmlmock_image:
        return
    # Same Dockerfile as nvml_mock.tiltfile, so only= must list the same trees.
    docker_build(
        _IMAGE,
        context='.',
        dockerfile=_DOCKERFILE,
        only=[
            'go.mod',
            'go.sum',
            'api/',
            'cmd/',
            'pkg/',
            'internal/',
            'shims/',
            'Makefile',
            'deployments/nvml-mock/',
        ],
    )


# Returns ['nvml-mock', 'imex-staged'], so consumers start once IMEX is staged.
def install(active_consumers, nvmlmock_image='', control_plane=False):
    # In mokka, as nvml_mock.tiltfile installs: NRI never injects the release's
    # own namespace, so workloads in default would get no mock GPUs.
    flags = [
        '--create-namespace',
        '--values', 'local/compute-domain/topology.yaml',
        '--values', 'local/compute-domain/nvml-mock.values.yaml',
    ]

    for consumer in active_consumers:
        overlay = 'local/' + consumer + '/nvml-mock.values.yaml'
        if os.path.exists(overlay):
            flags += ['--values', overlay]

    # The CI hook for values the job computes, as in local/nvml_mock.tiltfile.
    if os.path.exists('local/nvml-mock.values.local.yaml'):
        flags += ['--values', 'local/nvml-mock.values.local.yaml']

    image_deps = []
    image_keys = []
    if nvmlmock_image:
        repo, tag, digest = split_image(nvmlmock_image)
        flags += ['--set', 'image.repository=' + repo]
        if tag:
            flags += ['--set', 'image.tag=' + tag]
        if digest:
            flags += ['--set', 'image.digest=' + digest]
    else:
        image_deps.append(_IMAGE)
        image_keys.append(('image.repository', 'image.tag'))
    if control_plane:
        flags += ['--set', 'controlPlane.enabled=true']
        image_deps.append('ghcr.io/nvidia/mokka-control-plane')
        image_keys.append(('controlPlane.image.repository', 'controlPlane.image.tag'))

    # Tilt looks image_deps up in the resource graph, so they go only when
    # build_image() actually built something.
    if image_deps:
        helm_resource(
            'nvml-mock',
            _CHART,
            namespace=_NAMESPACE,
            image_deps=image_deps,
            image_keys=image_keys,
            flags=flags,
            labels=['mokka'],
        )
    else:
        helm_resource('nvml-mock', _CHART, namespace=_NAMESPACE, flags=flags, labels=['mokka'])

    if control_plane:
        k8s_attach(
            name='nvml-mock-control-plane',
            obj='deployment/nvml-mock-control-plane',
            namespace='mokka',
            resource_deps=['nvml-mock'],
            labels=['mokka-core'],
        )

    local_resource(
        'check-fabric',
        cmd='bash local/compute-domain/scenarios/check-fabric.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    local_resource(
        'topology-rebind',
        cmd='bash local/compute-domain/scenarios/topology-rebind.sh',
        resource_deps=['nvml-mock'],
        auto_init=False,
        labels=['compute-domain-tests'],
    )

    # The DRA driver's compute-domain kubelet plugin looks for the IMEX
    # binaries only when it starts, so consumers wait until every node has
    # staged IMEX, which a download can take a while to do.
    local_resource(
        'imex-staged',
        cmd='bash local/compute-domain/scenarios/wait-imex.sh',
        resource_deps=['nvml-mock'],
        labels=['mokka'],
    )

    return ['nvml-mock', 'imex-staged']
