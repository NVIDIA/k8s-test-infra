#
# extra_resource_deps exists for --observability: its overlay gives dcgm-exporter a
# ServiceMonitor, which needs kube-prometheus-stack's CRD to exist first.

load('ext://helm_resource', 'helm_resource')

_REPO_RESOURCE = 'nvidia'

_CHART = 'nvidia/gpu-operator'

# Two pins, by what the scenario's operands can run. v26.7.1 gates every
# operand's toolkit-validation init container on an `nvidia` line in /proc/modules
# (NVIDIA/gpu-operator#2881). The userspace driver mode cannot serve that line to
# those containers, so GFD, the device plugin and dcgm-exporter never start
# (#911), and it stays on the last release before the gate. The kernel mode's
# simulated modules serve the line.
_CHART_VERSION = 'v26.3.3'
_GATED_CHART_VERSION = 'v26.7.2'

def install(nvml_mock_releases, extra_values=[], extra_resource_deps=[], kernel_mode=False):
    values_flags = ['--values', 'local/gpu-operator/gpu-operator.values.yaml']
    for v in extra_values:
        values_flags += ['--values', v]
    version = _GATED_CHART_VERSION if kernel_mode else _CHART_VERSION

    helm_resource(
        'gpu-operator',
        _CHART,
        namespace='gpu-operator',
        flags=['--create-namespace', '--version', version] + values_flags + ['--timeout', '300s'],
        resource_deps=[_REPO_RESOURCE] + nvml_mock_releases + extra_resource_deps,
        labels=['gpu-operator'],
    )
