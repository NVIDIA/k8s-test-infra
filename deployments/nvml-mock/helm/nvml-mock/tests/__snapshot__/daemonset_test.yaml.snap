            - configMap:
                name: RELEASE-NAME-nvml-mock-config
              name: mokka-profile
            - hostPath:
                path: /var/run/cdi
                type: DirectoryOrCreate
              name: cdi-specs
            - hostPath:
                path: /var/run/nri
                type: DirectoryOrCreate
              name: nri-socket-dir
            - emptyDir:
                medium: Memory
                sizeLimit: 1Mi
              name: staging-gate
            - hostPath:
                path: /run/nvidia
                type: DirectoryOrCreate
              name: driver-root-link
            - hostPath:
                path: /etc/kubernetes/node-feature-discovery/features.d
                type: DirectoryOrCreate
              name: nfd-features
            - hostPath:
                path: /sys
                type: Directory
              name: node-sysfs
            - configMap:
                name: RELEASE-NAME-nvml-mock-mig-profiles
              name: mig-profiles
            - hostPath:
                path: /var/lib/nvml-mock/fabric-state
                type: DirectoryOrCreate
              name: fabric-state
      updateStrategy:
        rollingUpdate:
          maxUnavailable: 25%
        type: RollingUpdate
