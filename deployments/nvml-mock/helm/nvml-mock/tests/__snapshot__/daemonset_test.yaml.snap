should match snapshot with all overrides:
  1: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/component: daemon
        app.kubernetes.io/instance: custom
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: nvml-mock
        app.kubernetes.io/version: 0.0.0-dev
        helm.sh/chart: nvml-mock-0.0.0-dev
      name: nvml-mock-custom
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/instance: custom
          app.kubernetes.io/name: nvml-mock
      template:
        metadata:
          annotations:
            checksum/config: 5f60b3ba88c53f04c2834ac3d0a531afe660954c5fcd16715829e26f050efeea
            checksum/mig-profiles: 7f5c00954886487b5209e5d1724a12cb1c9555a6c1fbf79d10f385fed9923237
          labels:
            app.kubernetes.io/component: daemon
            app.kubernetes.io/instance: custom
            app.kubernetes.io/name: nvml-mock
        spec:
          automountServiceAccountToken: false
          containers:
            - command:
                - /usr/local/bin/node-agent
                - start
                - --config=/etc/nvml-mock/config.yaml
                - --host-root=/host
                - --health-addr=:9091
                - --log-level=info
                - --log-format=json
                - --shutdown-timeout=5s
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: GPU_COUNT
                  value: "2"
                - name: DRIVER_VERSION
                  value: 555.55.55
                - name: MOCK_FABRICMANAGER_STATE_DIR
                  value: /var/lib/nvml-mock/fabric-state
                - name: MOCK_IB
                  value: full
                - name: MOCK_IB_PING_FABRIC
                  value: "1"
                - name: MOCK_IB_PING_PORT
                  value: "18515"
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: MOCK_IB_PING_SERVICE_HOST
                  value: nvml-mock-custom-ibping.gpu-system.svc.cluster.local
                - name: MOCK_NVML_CONFIG
                  value: /etc/nvml-mock/config.yaml
                - name: MOCK_NVML_OVERRIDES
                  value: /var/lib/nvml-mock/driver/config/overrides.yaml
                - name: MOCK_NVML_KMSG
                  value: ""
                - name: MOCK_MIG_PROFILES_CONFIG
                  value: /etc/nvml-mock/mig/mig-profiles.yaml
                - name: MOCK_IB_PING_SOCKET
                  value: /var/lib/nvml-mock/run/mock-ib.sock
                - name: LD_PRELOAD
                  value: /usr/local/lib/libibmockumad.so.1:/usr/local/lib/libibmockverbs.so.1:/usr/local/lib/libibmocksys.so.1:/usr/local/lib/libmockfs.so.1
                - name: MOCK_IB_ROOT
                  value: /var/lib/nvml-mock/ib
                - name: MOCK_PCI_ROOT
                  value: /var/lib/nvml-mock
              image: custom-registry/nvml-mock:v2.0.0
              imagePullPolicy: Always
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 9091
              name: node-agent
              ports:
                - containerPort: 9091
                  name: health
                  protocol: TCP
                - containerPort: 18515
                  name: ibping
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: 9091
              resources:
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /host/var/lib/nvml-mock
                  name: mokka-root
                - mountPath: /var/lib/nvml-mock
                  name: mokka-root
                - mountPath: /host/run/nvidia
                  mountPropagation: Bidirectional
                  name: driver-root-link
                - mountPath: /host/run/cdi
                  name: cdi-specs
                - mountPath: /etc/nvml-mock
                  name: mokka-profile
                  readOnly: true
                - mountPath: /host/etc/kubernetes/node-feature-discovery/features.d
                  name: nfd-features
                - mountPath: /etc/nvml-mock/mig
                  name: mig-profiles
                  readOnly: true
                - mountPath: /host/var/lib/nvml-mock/fabric-state
                  name: fabric-state
                - mountPath: /host/sys
                  name: node-sysfs
                  readOnly: true
          nodeSelector:
            mokka.nvidia.com/type: sgpu
          serviceAccountName: nvml-mock-custom
          terminationGracePeriodSeconds: 10
          tolerations:
            - effect: NoSchedule
              key: nvidia.com/gpu
              operator: Exists
          volumes:
            - hostPath:
                path: /var/lib/nvml-mock
                type: DirectoryOrCreate
              name: mokka-root
            - configMap:
                name: nvml-mock-custom-config
              name: mokka-profile
            - hostPath:
                path: /var/run/cdi
                type: DirectoryOrCreate
              name: cdi-specs
            - hostPath:
                path: /run/nvidia
                type: DirectoryOrCreate
              name: driver-root-link
            - hostPath:
                path: /etc/kubernetes/node-feature-discovery/features.d
                type: DirectoryOrCreate
              name: nfd-features
            - hostPath:
                path: /sys
                type: Directory
              name: node-sysfs
            - configMap:
                name: nvml-mock-custom-mig-profiles
              name: mig-profiles
            - hostPath:
                path: /var/lib/nvml-mock/fabric-state
                type: DirectoryOrCreate
              name: fabric-state
      updateStrategy:
        rollingUpdate:
          maxUnavailable: 25%
        type: RollingUpdate
