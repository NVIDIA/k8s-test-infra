should match snapshot with all overrides:
  1: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/component: daemon
        app.kubernetes.io/instance: custom
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: nvml-mock
        app.kubernetes.io/version: 0.0.0-dev
        helm.sh/chart: nvml-mock-0.0.0-dev
      name: nvml-mock-custom
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/instance: custom
          app.kubernetes.io/name: nvml-mock
      template:
        metadata:
          annotations:
            checksum/config: e6d71764d57f62b23b4955ed931fe3e76fabb7c583323667d0463493c897d074
            checksum/mig-profiles: 7f5c00954886487b5209e5d1724a12cb1c9555a6c1fbf79d10f385fed9923237
            kubectl.kubernetes.io/default-container: node-agent
          labels:
            app.kubernetes.io/component: daemon
            app.kubernetes.io/instance: custom
            app.kubernetes.io/name: nvml-mock
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --socket-path=/var/run/nri/nri.sock
                - --plugin-name=nvml-mock
                - --plugin-index=10
                - --overlay-host-path=/var/lib/nvml-mock
                - --overlay-mount-path=/opt/nvml-mock
                - --device-host-path=/var/lib/nvml-mock/driver/dev
                - --opt-out-annotation=nvml-mock.nvidia.com/inject
                - --device-annotation=nvml-mock.nvidia.com/devices
                - --device-injection-mode=raw
                - --cdi-spec-host-path=/var/run/cdi/nvml-mock-nri.yaml
                - --imex-channel-annotation=nvml-mock.nvidia.com/imex-channels
                - --imex-channel-host-path=/var/lib/nvml-mock/driver/dev/nvidia-caps-imex-channels
                - --infiniband-annotation=nvml-mock.nvidia.com/infiniband
                - --excluded-namespaces=gpu-system,kube-system
                - --node-name=$(NODE_NAME)
                - --health-addr=:8080
                - --agent-staged-url=http://127.0.0.1:9091/stagedz
                - --staging-lock-path=/run/nvml-mock/nri-staging.lock
                - --log-level=info
                - --log-format=json
              command:
                - /usr/local/bin/nri-plugin
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
              image: custom-registry/nvml-mock:v2.0.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: nri-health
                periodSeconds: 10
                timeoutSeconds: 2
              name: nvml-mock-nri
              ports:
                - containerPort: 8080
                  name: nri-health
                  protocol: TCP
              readinessProbe:
                failureThreshold: 2
                httpGet:
                  path: /readyz
                  port: nri-health
                periodSeconds: 10
                timeoutSeconds: 2
              resources:
                requests:
                  cpu: 10m
                  memory: 32Mi
              securityContext:
                allowPrivilegeEscalation: false
                runAsUser: 0
              volumeMounts:
                - mountPath: /var/run/nri
                  name: nri-socket-dir
                - mountPath: /run/nvml-mock
                  name: staging-gate
                  readOnly: true
                - mountPath: /var/lib/nvml-mock
                  name: mokka-root
                  readOnly: true
                - mountPath: /var/run/cdi
                  name: cdi-specs
                  readOnly: true
          initContainers:
            - command:
                - /usr/local/bin/node-agent
                - start
                - --config=/etc/nvml-mock/config.yaml
                - --host-root=/host
                - --health-addr=:9091
                - --log-level=info
                - --log-format=json
                - --shutdown-timeout=5s
                - --resync-interval=1m
                - --staging-lock-path=/run/nvml-mock/nri-staging.lock
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: GPU_COUNT
                  value: "2"
                - name: DRIVER_VERSION
                  value: 555.55.55
                - name: MOCK_FABRICMANAGER_STATE_DIR
                  value: /var/lib/nvml-mock/fabric-state
                - name: MOCK_IB
                  value: full
                - name: MOCK_IB_PING_FABRIC
                  value: "1"
                - name: MOCK_IB_PING_PORT
                  value: "18515"
                - name: POD_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.podIP
                - name: MOCK_IB_PING_SERVICE_HOST
                  value: nvml-mock-custom-ibping.gpu-system.svc.cluster.local
                - name: MOCK_NVML_CONFIG
                  value: /etc/nvml-mock/config.yaml
                - name: MOCK_NVML_OVERRIDES
                  value: /var/lib/nvml-mock/driver/config/overrides.yaml
                - name: MOCK_NVML_KMSG
                  value: ""
                - name: MOCK_MIG_PROFILES_CONFIG
                  value: /etc/nvml-mock/mig/mig-profiles.yaml
                - name: MOCK_IB_PING_SOCKET
                  value: /var/lib/nvml-mock/run/mock-ib.sock
                - name: LD_PRELOAD
                  value: /usr/local/lib/libibmockumad.so.1:/usr/local/lib/libibmockverbs.so.1:/usr/local/lib/libibmocksys.so.1:/usr/local/lib/libmockfs.so.1
                - name: MOCK_IB_ROOT
                  value: /var/lib/nvml-mock/ib
                - name: MOCK_PCI_ROOT
                  value: /var/lib/nvml-mock
              image: custom-registry/nvml-mock:v2.0.0
              imagePullPolicy: Always
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: health
              name: node-agent
              ports:
                - containerPort: 9091
                  name: health
                  protocol: TCP
                - containerPort: 18515
                  name: ibping
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: health
              resources:
                requests:
                  cpu: 10m
                  memory: 32Mi
              restartPolicy: Always
              securityContext:
                privileged: true
              startupProbe:
                failureThreshold: 120
                httpGet:
                  path: /stagedz
                  port: health
                periodSeconds: 1
                timeoutSeconds: 1
              volumeMounts:
                - mountPath: /host/var/lib/nvml-mock
                  name: mokka-root
                - mountPath: /var/lib/nvml-mock
                  name: mokka-root
                - mountPath: /host/run/nvidia
                  mountPropagation: Bidirectional
                  name: driver-root-link
                - mountPath: /host/run/cdi
                  name: cdi-specs
                - mountPath: /etc/nvml-mock
                  name: mokka-profile
                  readOnly: true
                - mountPath: /host/etc/kubernetes/node-feature-discovery/features.d
                  name: nfd-features
                - mountPath: /run/nvml-mock
                  name: staging-gate
                - mountPath: /etc/nvml-mock/mig
                  name: mig-profiles
                  readOnly: true
                - mountPath: /host/var/lib/nvml-mock/fabric-state
                  name: fabric-state
                - mountPath: /host/sys
                  name: node-sysfs
                  readOnly: true
          nodeSelector:
            mokka.nvidia.com/type: sgpu
          serviceAccountName: nvml-mock-custom
          terminationGracePeriodSeconds: 10
          tolerations:
            - effect: NoSchedule
              key: nvidia.com/gpu
              operator: Exists
          volumes:
            - hostPath:
                path: /var/lib/nvml-mock
                type: DirectoryOrCreate
              name: mokka-root
            - configMap:
                name: nvml-mock-custom-config
              name: mokka-profile
            - hostPath:
                path: /var/run/cdi
                type: DirectoryOrCreate
              name: cdi-specs
            - hostPath:
                path: /var/run/nri
                type: DirectoryOrCreate
              name: nri-socket-dir
            - emptyDir:
                medium: Memory
                sizeLimit: 1Mi
              name: staging-gate
            - hostPath:
                path: /run/nvidia
                type: DirectoryOrCreate
              name: driver-root-link
            - hostPath:
                path: /etc/kubernetes/node-feature-discovery/features.d
                type: DirectoryOrCreate
              name: nfd-features
            - hostPath:
                path: /sys
                type: Directory
              name: node-sysfs
            - configMap:
                name: nvml-mock-custom-mig-profiles
              name: mig-profiles
            - hostPath:
                path: /var/lib/nvml-mock/fabric-state
                type: DirectoryOrCreate
              name: fabric-state
      updateStrategy:
        rollingUpdate:
          maxUnavailable: 25%
        type: RollingUpdate
