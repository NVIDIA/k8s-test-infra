"""Point a frozen docs version's links to this repository at its release tag.

Pages link to files and downloads on the main branch, which keeps moving after a
release. In a copy of the docs frozen at tag REF, this rewrites
github.com/NVIDIA/k8s-test-infra/{blob,tree}/main/PATH and
raw.githubusercontent.com/NVIDIA/k8s-test-infra/main/PATH to REF, so the version
reads the files it was released with. A PATH that does not exist at REF keeps
pointing at main, because rewriting it would publish a broken link.

Usage: pin-docs-links REF DIR
"""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

LINK = re.compile(
    r"(?P<prefix>https://(?:github\.com/NVIDIA/k8s-test-infra/(?:blob|tree)"
    r"|raw\.githubusercontent\.com/NVIDIA/k8s-test-infra))/main/"
    r"(?P<path>[A-Za-z0-9._/-]*)"
)


def exists(ref: str, path: str, cache: dict[str, bool]) -> bool:
    path = path.rstrip("/")
    if path not in cache:
        spec = f"{ref}:{path}" if path else f"{ref}^{{tree}}"
        result = subprocess.run(
            ["git", "cat-file", "-e", spec], capture_output=True, check=False
        )
        cache[path] = result.returncode == 0
    return cache[path]


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__.strip().split("\n")[-1], file=sys.stderr)
        return 2
    ref, root = sys.argv[1], Path(sys.argv[2])
    if subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}"],
        capture_output=True,
        check=False,
    ).returncode != 0:
        print(f"ERROR: {ref} is not a commit in this repository", file=sys.stderr)
        return 1

    cache: dict[str, bool] = {}

    def pin(match: re.Match[str]) -> str:
        if not exists(ref, match.group("path"), cache):
            return match.group(0)
        return f"{match.group('prefix')}/{ref}/{match.group('path')}"

    for page in sorted(root.rglob("*.md")):
        text = page.read_text(encoding="utf-8")
        pinned = LINK.sub(pin, text)
        if pinned != text:
            page.write_text(pinned, encoding="utf-8")
    kept = sorted(path for path, found in cache.items() if not found)
    for path in kept:
        print(f"{root}: {path} does not exist at {ref}; its links stay on main")
    return 0


if __name__ == "__main__":
    sys.exit(main())
