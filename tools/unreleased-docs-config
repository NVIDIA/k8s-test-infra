"""Write a Fern config that builds docs/ as it is now, without the released versions.

Once fern/docs.yml lists versions, Fern builds only those, from content frozen
at their tags, and ignores the product's own path to docs/index.yml. The checks,
the local preview and pull request previews need the pages that will ship in the
next release, so they build this copy instead. It is fern/docs.yml without its
versions, with the product path rewritten for the copy's location.

The copy is written to OUT/fern, since the Fern CLI looks for a directory with
that name.

Usage: unreleased-docs-config OUT
"""

from __future__ import annotations

import os
import re
import shutil
import sys
from pathlib import Path

PRODUCT_PATH = "../docs/index.yml"
VERSIONS = re.compile(r"^(?P<indent>\s*)versions:\s*$")


def without_versions(lines: list[str]) -> list[str]:
    out: list[str] = []
    skip_deeper_than: int | None = None
    for line in lines:
        indent = len(line) - len(line.lstrip())
        if skip_deeper_than is not None:
            if not line.strip() or indent > skip_deeper_than:
                continue
            skip_deeper_than = None
        match = VERSIONS.match(line)
        if match:
            skip_deeper_than = len(match.group("indent"))
            continue
        out.append(line)
    return out


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__.strip().split("\n")[-1], file=sys.stderr)
        return 2
    repo = Path(__file__).resolve().parent.parent
    out = Path(sys.argv[1]).resolve() / "fern"
    shutil.rmtree(out, ignore_errors=True)
    out.mkdir(parents=True)
    shutil.copy(repo / "fern" / "fern.config.json", out)

    lines = without_versions((repo / "fern" / "docs.yml").read_text(encoding="utf-8").split("\n"))
    relocated = os.path.relpath(repo / "docs" / "index.yml", out)
    text = "\n".join(lines)
    if f"path: {PRODUCT_PATH}" not in text:
        print(f"ERROR: fern/docs.yml has no product path {PRODUCT_PATH}", file=sys.stderr)
        return 1
    (out / "docs.yml").write_text(
        text.replace(f"path: {PRODUCT_PATH}", f"path: {relocated}"), encoding="utf-8"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
