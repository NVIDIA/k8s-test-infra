      "text": "Most configurations \nare left in the concreate installation\nwithout a layer to store/configure the\nmost common of them",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Most configurations \nare left in the concreate installation\nwithout a layer to store/configure the most common of them",
      "autoResize": false,
      "lineHeight": 1.25
    },
